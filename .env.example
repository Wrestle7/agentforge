# Copy to .env in agentforge/. No key is needed for demo/eval --mode fixture.
AF_DATA_DIR=data
# Optional: PostgreSQL events + pgvector + LangGraph checkpoints. Otherwise SQLite.
# AF_DATABASE_URL=postgresql://agentforge:agentforge_dev@127.0.0.1:15432/agentforge
# Provider must support chat/completions JSON mode. Key stays local.
AF_LLM_BASE_URL=http://127.0.0.1:11434/v1
AF_LLM_MODEL=
AF_LLM_THINKING=auto
AF_LLM_API_KEY=''
AF_MAX_TOKENS=30000
AF_MAX_MODEL_OUTPUT=2000
AF_MAX_ITERATIONS=20
AF_MAX_TOOL_CALLS=40
AF_MAX_SECONDS=300
# Optional USD per million tokens, supplied by user/provider pricing.
# AF_INPUT_PRICE=
# AF_OUTPUT_PRICE=
AF_TAVILY_API_KEY=
# Local hashed vectors are reproducible, NOT semantic embeddings.
AF_EMBEDDING_BACKEND=hash
# Semantic API backend (Bailian example; separate from DeepSeek chat):
# AF_EMBEDDING_BACKEND=api
# AF_EMBEDDING_MODEL=text-embedding-v4
# AF_EMBEDDING_DIM=1024
# AF_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Fill AF_EMBEDDING_API_KEY with the key from the same region/workspace.
# Base URL must NOT include /embeddings. Use the actual URL shown by your console.
AF_EMBEDDING_MODEL=
AF_EMBEDDING_BASE_URL=
AF_EMBEDDING_API_KEY=
AF_EMBEDDING_DIM=256
# Optional local backend: pip install -e '.[semantic]'; downloads only when first used.
# AF_EMBEDDING_BACKEND=local
# AF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# AF_EMBEDDING_DIM=384
# AF_EMBEDDING_CACHE=D:/software/models/fastembed
# Explicitly opt in to send prompts/evidence to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentforge

